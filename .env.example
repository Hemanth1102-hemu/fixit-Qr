# ==============================================================================
# FixIt QR — Smart Campus Maintenance System
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Fill in your genuine Supabase credentials obtained from:
#    https://app.supabase.com/project/_/settings/api
# 3. NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase API Configuration (Server)
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
# Service role key is STRICTLY for trusted backend operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Client (Frontend) Configuration (Exposed to browser via Vite)
# These MUST match your Supabase public credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
VITE_API_URL=http://localhost:5001/api/v1
